# ======================
# CALCULATOR TESTS
# ======================
// =============================================
//  CVM++ Sample Program: Interactive Calculator
//  Tests: input, arithmetic ops, print
// =============================================

// Read two numbers from the user
print 0;        // prompt user (print signals: enter first number)
let a = input;

print 0;        // prompt user (print signals: enter second number)
let b = input;

// Compute all four operations
let sum  = a + b;
let diff = a - b;
let prod = a * b;
let quot = a / b;

// Print results
print sum;
print diff;
print prod;
print quot;



# ======================
# FIBONACCI TESTS
# ======================
// =============================================
//  CVM++ Sample Program: Fibonacci Sequence
//  Tests: while loop, variables, arithmetic
//  Input: N (how many terms to print)
//  Output: first N Fibonacci numbers
// =============================================

let n    = input;   // number of terms
let a    = 0;
let b    = 1;
let i    = 0;

while (i < n) {
    print a;
    let temp = a + b;
    a = b;
    b = temp;
    i = i + 1;
}

// Example: input 8 → 0 1 1 2 3 5 8 13

# =================
# TRUTH MACHINE
# =================

// =============================================
//  CVM++ Sample Program: Truth Machine
//  Classic CS demo — tests: if, while, input
//  Input 0 → prints 0 once and halts
//  Input 1 → prints 1 forever (infinite loop)
// =============================================

let x = input;

if (x == 0) {
    print 0;
}

while (x == 1) {
    print 1;
}

