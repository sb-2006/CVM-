// =============================================
//  CVM++ Sample Program: Fibonacci Sequence
//  Tests: while loop, variables, arithmetic
//  Input: N (how many terms to print)
//  Output: first N Fibonacci numbers
// =============================================

let n    = input;   // number of terms
let a    = 0;
let b    = 1;
let i    = 0;

while (i < n) {
    print a;
    let temp = a + b;
    a = b;
    b = temp;
    i = i + 1;
}

// Example: input 8 → 0 1 1 2 3 5 8 13