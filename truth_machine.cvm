// =============================================
//  CVM++ Sample Program: Truth Machine
//  Classic CS demo — tests: if, while, input
//  Input 0 → prints 0 once and halts
//  Input 1 → prints 1 forever (infinite loop)
// =============================================

let x = input;

if (x == 0) {
    print 0;
}

while (x == 1) {
    print 1;
}
